{
  "name": "waypoint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @waypoint/web db:generate",
    "db:migrate": "pnpm --filter @waypoint/web db:migrate",
    "db:migrate:deploy": "pnpm --filter @waypoint/web db:migrate:deploy",
    "db:seed": "pnpm --filter @waypoint/web db:seed",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.2"
  }
}
