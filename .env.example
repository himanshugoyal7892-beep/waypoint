# Copy to apps/web/.env.local (Next.js) and apps/web/.env (Prisma CLI) and fill in.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser;
# everything else is server-only.

# --- Database (server-only) ---------------------------------------------------
# Local: matches docker-compose.yml. Production (Neon): DATABASE_URL = pooled URL,
# DIRECT_URL = direct (non-pooled) URL used by migrations.
DATABASE_URL="postgresql://waypoint:waypoint_local_only@localhost:5432/waypoint?schema=public"
DIRECT_URL="postgresql://waypoint:waypoint_local_only@localhost:5432/waypoint?schema=public"

# --- Public URLs (browser-visible) ---------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL of the embeddable SDK bundle, used in the install snippet.
NEXT_PUBLIC_SDK_URL="http://localhost:3000/sdk/product-tour.js"

# --- Clerk ----------------------------------------------------------------------
# Optional in development: if both keys are empty, Clerk runs in keyless mode.
# Required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""   # browser-visible (publishable)
CLERK_SECRET_KEY=""                    # server-only. Never expose.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Rate limiting (server-only) ------------------------------------------------
# memory = per-process (local dev only). upstash = distributed (use in production).
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Demo/staging only: set to "true" to run production with the memory limiter (weaker protection:
# limits are per server instance). Leave "false" for real production and use Upstash.
ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION="false"

# --- Builder pass (server-only) -------------------------------------------------
BUILDER_PASS_TTL_MINUTES="120"

# --- Seed (server-only, local dev) ----------------------------------------------
# Set to YOUR Clerk user id (user_...) so the seeded demo project appears in your dashboard.
SEED_CLERK_USER_ID="user_seed_demo"
SEED_USER_EMAIL="demo@example.com"
