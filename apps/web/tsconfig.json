{
  "extends": "@waypoint/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "prisma/**/*.ts",
    ".next/types/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
