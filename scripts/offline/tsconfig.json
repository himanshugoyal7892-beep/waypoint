{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["/opt/node-tools/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "vitest": ["./vitest-shim.ts"],
      "@waypoint/shared": ["./shared-pure.ts"],
      "@/*": ["../../apps/web/src/*"]
    }
  },
  "include": []
}
